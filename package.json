  "private": true,
  "dependencies": {
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-gtm-module": "^2.0.11",
    "styled-components": "^6.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "prepreview": "npm run build",
    "preview": "vite preview",
    "preview:check": "node scripts/verify-preview.mjs",
    "font:check": "node scripts/verify-font-delivery.mjs",
    "test": "vitest run",
    "build:check": "tsc --noEmit && vite build --outDir .build-check"
