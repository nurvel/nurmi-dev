{
  "name": "nurmi.dev",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-gtm-module": "^2.0.11",
    "styled-components": "^6.5.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "prepreview": "npm run build",
    "preview": "vite preview",
    "preview:check": "node scripts/verify-preview.mjs",
    "font:check": "node scripts/verify-font-delivery.mjs",
    "test": "vitest run",
    "build:check": "tsc --noEmit && vite build --outDir .build-check"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-gtm-module": "^2.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
