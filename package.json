{
  "name": "nurmi.dev",
  "version": "2.3.1",
  "private": true,
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-gtm-module": "^2.0.11",
    "styled-components": "^6.6.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "prepreview": "npm run build",
    "preview": "vite preview",
    "preview:check": "node scripts/verify-preview.mjs",
    "font:check": "node scripts/verify-font-delivery.mjs",
    "test": "vitest run",
    "build:check": "tsc --noEmit && vite build --outDir .build-check"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-gtm-module": "^2.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
